/ {
    aliases {
        lora0 = &lora;
    };
};

&lora {
    status = "okay";
    /* Use the correct enum strings for STM32WL */
    power-amplifier-output = "rfo-hp"; 
    
    antenna-enable-gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>,  /* FE_CTRL1 */
                           <&gpioc 5 GPIO_ACTIVE_HIGH>,  /* FE_CTRL2 */
                           <&gpioc 3 GPIO_ACTIVE_HIGH>;  /* FE_CTRL3 */
};

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
    pinctrl-names = "default";

    bme280: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
        status = "okay";
    };
};

&rtc {
    status = "okay";
};